// Prisma schema — Karnet.asist
// Źródło: docs/DATABASE.md (v3_paczka_dok/v2/docs/DATABASE.md), status tam: DRAFT.
// Nazwy pól w schemacie: camelCase (konwencja TS/Prisma), zmapowane na snake_case
// w bazie przez @map/@@map, zgodnie z nazwami kolumn z DATABASE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL skonfigurowany w prisma.config.ts (Prisma 7 nie wspiera już
// `url` bezpośrednio w bloku datasource schema.prisma).
datasource db {
  provider = "postgresql"
}

// Paleta kolorów kategorii (Sesja 16) — zamknięty zbiór, egzekwowany na poziomie bazy
// jak pozostałe enumy w tym schemacie. Wartości odpowiadają tokenom design systemu
// (`--mint`, `--coral`, `--accent`) z globals.css + 3 nowe (`sky`, `violet`, `slate`)
// dodane specjalnie pod kategorie, żeby było z czego wybierać dla 5 systemowych +
// własnych kategorii użytkownika.
enum CategoryColor {
  mint
  coral
  accent
  sky
  violet
  slate

  @@map("category_color")
}

enum CardType {
  limit
  unlimited

  @@map("card_type")
}

enum VoucherMode {
  single
  per_visit

  @@map("voucher_mode")
}

/// Konto opcjonalne — brak konta = brak wiersza (ADR-003).
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  /// Hash hasła (bcrypt), tylko dla kont e-mail+hasło (Sesja V6.1). Nullable — konta
  /// założone przez Google OAuth nie mają hasła.
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")

  cards             Card[]
  favorites         Favorite[]
  createdCompanies  Company[]          @relation("CompanyCreatedBy")
  accounts          Account[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

/// Konto OAuth powiązane z użytkownikiem (Sesja 14 — logowanie Google przez
/// Auth.js/NextAuth). Nazwy pól `access_token`/`refresh_token`/`expires_at`/
/// `token_type`/`id_token`/`session_state` są literalnym wymogiem kontraktu
/// adaptera Prisma z `@auth/prisma-adapter` (spread obiektu 1:1 do `prisma.account.create`)
/// — świadome odstępstwo od konwencji camelCase-w-polu/@map-na-snake_case z reszty schematu.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Sesja logowania NextAuth. W praktyce nieużywana przy `session: { strategy: "jwt" }`
/// (ADR-003 — sesja jako podpisany token, nie rekord w bazie), ale model musi istnieć,
/// bo interfejs adaptera Prisma z niego korzysta (nawet jeśli metody sesji nie są
/// wywoływane w trybie jwt).
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Token weryfikacyjny (magic link / e-mail) — nieużywany przy logowaniu wyłącznie
/// przez Google OAuth, ale wymagany przez interfejs adaptera Prisma.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Kategoria firmy (Sesja 16) — od enuma stałego do tabeli, żeby użytkownicy mogli
/// dodawać własne kategorie obok 5 systemowych. `slug` ustawiony tylko dla kategorii
/// systemowych: stały klucz i18n (`companyCategory.<slug>`) niezależny od `id`.
/// `isSystem` odróżnia 5 kategorii startowych (niemodyfikowalnych przez użytkowników)
/// od kategorii dodanych ręcznie. `createdByDeviceId` nullable — kategoria użytkownika
/// jest prywatna dla urządzenia, które ją dodało (ustalone przed Sesją 16); dla kategorii
/// systemowych zawsze `null`. Weryfikacja `deviceId` jak wszędzie indziej — przez
/// podpisany token (ADR-007), nigdy przez surowe body/query.
model Category {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String?       @unique
  name              String
  color             CategoryColor
  isSystem          Boolean       @default(false) @map("is_system")
  createdByDeviceId String?       @map("created_by_device_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  companies Company[]

  @@index([createdByDeviceId])
  @@map("categories")
}

/// Partner (firma), np. siłownia, basen, salon masażu.
model Company {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  categoryId      String   @map("category_id") @db.Uuid
  lat             Float?
  lng             Float?
  googlePlaceId   String?  @map("google_place_id")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  category  Category   @relation(fields: [categoryId], references: [id])
  createdBy User?      @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id])
  cards     Card[]
  favorites Favorite[]

  @@index([categoryId])
  @@map("companies")
}

/// Karnet użytkownika. Reguła biznesowa (egzekwowana w API, docelowo też CHECK w DB —
/// patrz DATABASE.md): type = 'unlimited' ⇒ expiryDate IS NOT NULL.
/// Status ok/soon/urgent i archived liczone w locie, nie są kolumnami (patrz DATABASE.md).
model Card {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  deviceId       String?     @map("device_id")
  companyId      String      @map("company_id") @db.Uuid
  type           CardType
  totalVisits    Int?        @map("total_visits")
  usedVisits     Int         @default(0) @map("used_visits")
  expiryDate     DateTime?   @map("expiry_date") @db.Date
  voucherMode    VoucherMode @map("voucher_mode")
  voucherFileUrl String?     @map("voucher_file_url")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user    User?   @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  visits  Visit[]
  voucherFiles CardVoucherFile[]

  @@index([userId])
  @@index([deviceId])
  @@index([companyId])
  @@map("cards")
}

// Wiele plików/zdjęć vouchera na karnet (Sesja V6.2) — zastępuje dawny pojedynczy plik w
// `cards.voucher_file_url` (prefiks `storage:`, Sesja V4.3/ADR-009). Tryb tekstowy/link w
// `voucher_file_url` zostaje bez zmian, niezależny od tej tabeli. Limit liczby wierszy na
// karnet (5) egzekwowany w API, nie w bazie — patrz `VOUCHER_FILE_MAX_COUNT`.
model CardVoucherFile {
  id          String   @id @default(uuid()) @db.Uuid
  cardId      String   @map("card_id") @db.Uuid
  storagePath String   @map("storage_path")
  createdAt   DateTime @default(now()) @map("created_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("card_voucher_files")
}

/// Pojedyncze wejście na karnecie.
model Visit {
  id        String    @id @default(uuid()) @db.Uuid
  cardId    String    @map("card_id") @db.Uuid
  visitDate DateTime  @map("visit_date") @db.Date
  visitTime DateTime? @map("visit_time") @db.Time
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  card Card @relation(fields: [cardId], references: [id])

  @@index([cardId, visitDate(sort: Desc)])
  @@map("visits")
}

/// Ulubiony partner — klucz po userId (konto) lub deviceId (bez konta).
/// DATABASE.md proponuje złożony PK (user_id, company_id) lub (device_id, company_id),
/// ale Prisma/Postgres nie pozwalają na nullable kolumnę w PK — stąd osobne `id` (uuid)
/// jak w pozostałych tabelach, plus unikalność pilnowana osobno dla obu ścieżek
/// (NULL nie koliduje z NULL w unique constraint w Postgresie).
model Favorite {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @map("user_id") @db.Uuid
  deviceId  String? @map("device_id")
  companyId String  @map("company_id") @db.Uuid

  user    User?   @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@unique([deviceId, companyId])
  @@map("favorites")
}

/// Subskrypcja Web Push (Etap 6, PWA) — jedna na przeglądarkę/urządzenie, właścicielstwo
/// tak samo rozłączne jak przy Favorite/Card: userId (konto) albo deviceId (bez konta),
/// nigdy oba naraz w praktyce, ale oba nullable z tego samego powodu co gdzie indziej w
/// tym schemacie (Prisma/Postgres nie pozwala na nullable kolumnę w złożonym kluczu).
/// `endpoint` unikalny sam w sobie — to on identyfikuje kanał push w przeglądarce
/// (subskrypcja przeglądarki, nie użytkownika), więc ponowna rejestracja tego samego
/// urządzenia nadpisuje istniejący wiersz zamiast duplikować.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  deviceId  String?  @map("device_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("pl")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("push_subscriptions")
}
