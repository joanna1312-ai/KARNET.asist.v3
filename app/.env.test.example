# Wzorzec do .env.test — bazy testowej pod e2e (Playwright, Sesja 13).
# Skopiuj do .env.test i uzupełnij lokalnie. .env.test NIGDY nie trafia do repo (patrz
# .gitignore — wzorzec .env* z wyjątkiem .env.example obejmuje też ten plik).
#
# Wymaga uruchomionego kontenera db_test z docker-compose.yml w korzeniu repo
# (`docker compose up -d db_test`) — osobny od bazy dev, na porcie 5433, żeby testy e2e
# (reset/truncate tabel przed każdym przebiegiem) nigdy nie dotknęły danych z dev.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/karnet_asist_test

# Sekret tokenów urządzenia (ADR-007) używany tylko przez serwer Next uruchamiany na
# potrzeby e2e — celowo inny niż w .env, żeby środowiska się nie mieszały.
# Wygeneruj lokalnie: openssl rand -base64 32
DEVICE_TOKEN_SECRET=

# Auth.js/NextAuth (Sesja 14) — celowo inny sekret niż w .env, z tego samego powodu.
NEXTAUTH_SECRET=
