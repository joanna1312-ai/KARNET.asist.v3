# Skopiuj do .env i uzupełnij lokalnie. .env NIGDY nie trafia do repo (patrz .gitignore).
# Pełny opis zmiennych: ../v3_paczka_dok/v2/docs/SETUP.md

# Connection string do bazy Postgres (Supabase: Project Settings → Database →
# Connection string → Direct connection, nie pooler). Dla Supabase dopisz na końcu
# ?sslmode=require&uselibpqcompat=true — patrz docs/SETUP.md, sam sslmode=require nie
# wystarczy z nowszym sterownikiem pg.
DATABASE_URL=

# Google Maps JavaScript API + Places API (New) — używane po stronie przeglądarki
# (Sesja V4.1, ADR-004), więc klucz musi mieć prefiks NEXT_PUBLIC_. W Google Cloud
# ograniczyć klucz do tych dwóch interfejsów; ograniczenie do domeny dopiero przed
# wdrożeniem produkcyjnym (patrz plan-pracy-claude-code.md).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API (New) — osobny klucz serwerowy dla doradcy AI (Sesja V4.2a), oddzielny
# od klucza wyżej (ten jest ograniczony do referrerów przeglądarki i nie nadaje się do
# wywołań z backendu). Ograniczony w Google Cloud tylko do Places API (New).
GOOGLE_PLACES_SERVER_KEY=

# Auth.js/NextAuth — logowanie Google (Sesja 14, ADR-003: sesja jako jwt, nie
# rekord w bazie). Wygeneruj lokalnie: openssl rand -base64 32
NEXTAUTH_SECRET=
# Docelowa domena produkcyjna (redirect URI Google OAuth też musi na nią wskazywać);
# lokalnie http://localhost:3000
NEXTAUTH_URL=

# Google OAuth Client ID/Secret — Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sekret do podpisywania tokenów urządzenia w trybie bez konta (ADR-007).
# Wygeneruj lokalnie: openssl rand -base64 32
# Tylko po stronie serwera, nigdy z prefiksem NEXT_PUBLIC_.
DEVICE_TOKEN_SECRET=

# Groq API (Sesja V4.2a) — doradca AI (rekomendacje miejsc, sugestie na bazie karnetów).
# console.groq.com → API Keys. Wywołania wyłącznie po stronie serwera — bez prefiksu
# NEXT_PUBLIC_, klucz nigdy nie trafia do przeglądarki.
GROQ_API_KEY=

# Object storage na vouchery/zdjęcia (Supabase Storage / Cloudflare R2) — na razie nieużywane
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
